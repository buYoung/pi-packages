{
  "name": "@buyong/pi-ollama-cloud",
  "version": "0.15.3",
  "description": "Ollama Cloud provider, web search and fetch tools, and usage status for Pi.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src/",
    "CHANGELOG.md",
    "CHANGELOG.ko.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buYoung/pi-packages.git",
    "directory": "apps/pi-ollama-cloud"
  },
  "homepage": "https://github.com/buYoung/pi-packages/tree/main/apps/pi-ollama-cloud#readme",
  "bugs": {
    "url": "https://github.com/buYoung/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "biome check .",
    "typecheck": "tsgo --noEmit",
    "format": "biome format --write .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "cli": "tsx scripts/cli.ts",
    "smoke:web-tools": "tsx scripts/smoke-web-tools.ts",
    "generate-models": "tsx scripts/generate-models.ts",
    "generate-limits": "tsx scripts/generate-limits.ts",
    "generate-reasoning": "tsx scripts/generate-reasoning.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "@typescript/native-preview": "catalog:",
    "tsx": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "effect": "4.1.1",
    "proper-lockfile": "^4.1.2"
  }
}
