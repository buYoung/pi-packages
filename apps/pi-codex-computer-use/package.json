{
    "name": "@buyong/pi-codex-computer-use",
    "version": "0.2.1",
    "description": "Codex Computer Use and Browser Use for Pi. Runs the runtime installed by the Codex Desktop app with the same host flow Codex uses; nothing from OpenAI is bundled.",
    "license": "Apache-2.0",
    "keywords": [
        "pi-package",
        "pi-extension",
        "codex",
        "computer-use",
        "browser-use"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/buYoung/pi-packages.git",
        "directory": "apps/pi-codex-computer-use"
    },
    "homepage": "https://github.com/buYoung/pi-packages/tree/main/apps/pi-codex-computer-use#readme",
    "bugs": {
        "url": "https://github.com/buYoung/pi-packages/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "pi": {
        "extensions": [
            "./dist/index.js"
        ]
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "prepack": "tsc && node ../../scripts/codex/check-package.mjs ."
    },
    "dependencies": {
        "@earendil-works/pi-mcp": "1.4.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@earendil-works/pi-ai": "catalog:",
        "@earendil-works/pi-coding-agent": "catalog:",
        "@earendil-works/pi-tui": "catalog:",
        "@repo/typescript-config": "workspace:*",
        "@sinclair/typebox": "0.34.52",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "README.md",
        "README.ko.md",
        "LICENSE",
        "NOTICE",
        "docs/usage.md",
        "docs/usage.ko.md"
    ]
}
