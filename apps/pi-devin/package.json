{
  "name": "@buyong/pi-devin",
  "version": "0.1.16",
  "type": "module",
  "description": "Unofficial Pi provider for Devin accounts (OAuth)",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "./index.ts",
    "src/",
    "!src/cli/",
    "!src/core/index.ts",
    "!src/core/auth/index.ts",
    "!src/core/models/index.ts",
    "!src/core/inference/retry.ts",
    "!src/core/inference/state.ts",
    "!src/core/inference/stream-chat.ts",
    "!src/core/types.ts",
    "!src/pi/adapters/pi/types.ts",
    "!src/pi/features/accounts/types.ts",
    "!src/pi/features/auth/types.ts",
    "!src/pi/features/catalog/types.ts",
    "!src/pi/features/clients/types.ts",
    "!src/pi/features/inference/types.ts",
    "!src/pi/features/lifetime/types.ts",
    "!src/pi/features/runs/types.ts",
    "!src/pi/features/settings/types.ts",
    "!src/pi/features/sidekick/types.ts",
    "!src/pi/features/usage/types.ts",
    "proto",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buYoung/pi-packages.git",
    "directory": "apps/pi-devin"
  },
  "homepage": "https://github.com/buYoung/pi-packages/tree/main/apps/pi-devin#readme",
  "bugs": {
    "url": "https://github.com/buYoung/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify:offline": "vitest run",
    "test:unit": "vitest run",
    "cli": "node cli.ts",
    "prepack": "node scripts/bundle-dependencies.mjs",
    "postpack": "node scripts/bundle-dependencies.mjs --restore"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/platform-node-shared": "4.1.4",
    "effect": "4.1.4",
    "protobufjs": "8.8.1"
  },
  "bundleDependencies": [
    "@effect/platform-node",
    "@effect/platform-node-shared"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@earendil-works/pi-ai": "catalog:devin",
    "@earendil-works/pi-coding-agent": "catalog:devin",
    "@earendil-works/pi-tui": "catalog:devin",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
