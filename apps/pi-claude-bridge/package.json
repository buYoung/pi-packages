{
  "name": "@buyong/pi-claude-bridge",
  "version": "0.11.0",
  "private": false,
  "description": "Pi extension that uses Claude Code (via Agent SDK) as a model provider and adds an AskClaude tool.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-code",
    "claude-agent-sdk"
  ],
  "author": "Eli Dickinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buYoung/pi-packages.git",
    "directory": "apps/pi-claude-bridge"
  },
  "homepage": "https://github.com/buYoung/pi-packages/tree/main/apps/pi-claude-bridge#readme",
  "bugs": {
    "url": "https://github.com/buYoung/pi-packages/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test:unit": "node --import tsx --import ./tests/lib/setup.mjs --test tests/unit-*.mjs",
    "test": "set -a && [ -f .env.test ] && . .env.test; set +a; CLAUDE_BRIDGE_TEST_LOG_DIR=$(mktemp -d); export CLAUDE_BRIDGE_TEST_LOG_DIR; pnpm run test:unit && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test tests/int-*.mjs && node tests/lib/check-deadlock-logs.mjs \"$CLAUDE_BRIDGE_TEST_LOG_DIR\"",
    "test:usage": "tests/usage-test.sh",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cc-session-io": "^0.4.0",
    "change-case": "^5.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@inquirer/prompts": "8.5.2",
    "@types/node": "catalog:",
    "release-it": "21.0.1",
    "semver": "7.8.5",
    "tsx": "^4.22.4",
    "typebox": "catalog:",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
